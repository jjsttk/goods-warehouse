		{
			"name": "Get all products Pageable w/o params(default vals)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is JSON with pagination structure\", function () {",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
							"    const response = pm.response.json();",
							"    pm.expect(response).to.be.an(\"object\");",
							"    pm.expect(response).to.have.property(\"content\");",
							"    pm.expect(response).to.have.property(\"totalCount\");",
							"    pm.expect(response).to.have.property(\"totalPages\");",
							"    pm.expect(response).to.have.property(\"currentPage\");",
							"    pm.expect(response).to.have.property(\"pageSize\");",
							"    pm.expect(response).to.have.property(\"currentPageSize\");",
							"});",
							"",
							"pm.test(\"Response contains exactly 3 products\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.content).to.have.lengthOf(3);",
							"});",
							"",
							"pm.test(\"Total count is 3\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.totalCount).to.equal(3);",
							"});",
							"",
							"pm.test(\"Current page size is 3\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.currentPageSize).to.equal(3);",
							"});",
							"",
							"pm.test(\"Total pages is 1\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.totalPages).to.equal(1);",
							"});",
							"",
							"pm.test(\"Current page is 0\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.currentPage).to.equal(0);",
							"});",
							"",
							"pm.test(\"Page size is 20\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.pageSize).to.equal(20);",
							"});",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
