		{
			"name": "Try create not valid product",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"pm.test(\"Response has correct structure\", function () {",
							"    const response = pm.response.json();",
							"    ",
							"    pm.expect(response).to.have.property(\"message\");",
							"    pm.expect(response).to.have.property(\"validationErrors\");",
							"    pm.expect(response).to.have.property(\"exception\");",
							"    pm.expect(response).to.have.property(\"source\");",
							"    pm.expect(response).to.have.property(\"dateTime\");",
							"});",
							"",
							"pm.test(\"Message indicates validation failure\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.message).to.include(\"Validation failed\");",
							"});",
							"",
							"pm.test(\"Validation errors contain all expected fields\", function () {",
							"    const response = pm.response.json();",
							"    const errors = response.validationErrors;",
							"    ",
							"    pm.expect(errors).to.have.property(\"quantity\");",
							"    pm.expect(errors).to.have.property(\"price\");",
							"    pm.expect(errors).to.have.property(\"name\");",
							"    pm.expect(errors).to.have.property(\"article\");",
							"});",
							"",
							"pm.test(\"Error messages are correct\", function () {",
							"    const response = pm.response.json();",
							"    const errors = response.validationErrors;",
							"    ",
							"    pm.expect(errors.quantity[0]).to.equal(\"Quantity must be positive or zero\");",
							"    pm.expect(errors.price[0]).to.equal(\"Price must be positive\");",
							"    pm.expect(errors.name[0]).to.equal(\"Name must not be blank\");",
							"    pm.expect(errors.article[0]).to.include(\"already uses this article\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
