			"name": "Create product1",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has product ID\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.not.be.undefined;",
							"    pm.collectionVariables.set(\"firstProductId\", jsonData.id);",
							"});",
							"",
							"pm.test(\"All sent fields match response\", function () {",
							"    var responseJson = pm.response.json();",
							"    var requestBody = JSON.parse(pm.request.body.raw);",
							"    ",
							"    for (var key in requestBody) {",
							"        if (requestBody.hasOwnProperty(key)) {",
							"            pm.expect(responseJson[key]).to.eql(requestBody[key]);",
							"        }",
							"    }",
							"    ",
							"    pm.expect(responseJson.createdAt).to.not.be.undefined;",
							"    pm.expect(responseJson.lastQuantityModified).to.not.be.undefined;",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
